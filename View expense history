#include <iostream>
#include <fstream>
#include <string>
using namespace std;

int main() {
    ifstream file("expenses.txt");
    string date, category, description, amount;
    string line;
    int count = 0;

    while (getline(file, date, '|')) {
        getline(file, category, '|');
        getline(file, description, '|');
        getline(file, amount);

        cout << "\nDate: " << date
             << "\nCategory: " << category
             << "\nDescription: " << description
             << "\nAmount: Rs. " << amount << endl;
        count++;
    }

    file.close();

    if (count == 0)
        cout << "No expenses found.\n";

    return 0;
}
