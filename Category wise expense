#include <iostream>
#include <fstream>
#include <string>
using namespace std;

int main() {
    ifstream file("expenses.txt");
    string date, category, description, amount;
    string searchCategory;
    double total = 0, money;
    int found = 0;

    cout << "Enter category to search: ";
    cin >> searchCategory;

    while (getline(file, date, '|')) {
        getline(file, category, '|');
        getline(file, description, '|');
        getline(file, amount);

        if (category == searchCategory) {
            money = stod(amount);
            total += money;
            found = 1;
        }
    }

    file.close();

    if (found == 1)
        cout << "Total for " << searchCategory
             << ": Rs. " << total << endl;
    else
        cout << "No expenses found in this category.\n";

    return 0;
}
